{
  "expo": {
    "name": "Loan Tracker",
    "slug": "loan-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loantracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loantracker.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture loan utilization photos",
        "NSPhotoLibraryUsageDescription": "Save and select loan documentation",
        "NSLocationWhenInUseUsageDescription": "Verify loan utilization location",
        "NSMicrophoneUsageDescription": "Record loan utilization videos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.loantracker.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Capture loan utilization photos",
          "microphonePermission": "Record loan utilization videos",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Verify loan utilization location"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save and access loan documentation",
          "savePhotosPermission": "Save loan documentation photos",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
